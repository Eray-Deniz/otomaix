{
  "id": "sectorPkgErrNotify",
  "name": "Sektör Paketi Hata Bildirimi",
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Istanbul",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "nodes": [
    {
      "parameters": {},
      "id": "err-trigger",
      "name": "Hata Tetikleyici",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        400,
        -80
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "admin-chat",
              "name": "admin_chat_id",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-admin-target",
      "name": "Yönetici Hedefi",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        620,
        -80
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "nonempty",
              "leftValue": "={{ $json.admin_chat_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-admin-target",
      "name": "Hedef Kurulu mu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        -80
      ]
    },
    {
      "parameters": {
        "errorMessage": "Yönetici hedefi kurulu DEĞİL — bildirim gönderilmedi (fail-closed; tenant workspace'i hedef sayılmaz)."
      },
      "id": "stop-no-target",
      "name": "Hedefsiz — Dur",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        940,
        60
      ]
    },
    {
      "parameters": {
        "jsCode": "// Arıza özetini kurar. Sır TAŞIMAZ: yalnız workflow adı, çalıştırma\n// kimliği, düğüm adı ve hata mesajı basılır; `stack` ve ham `data`\n// DIŞARIDA bırakılır — yığın izi bağlantı dizesi ve başlık taşıyabilir.\nconst hata = $('Hata Tetikleyici').first().json || {};\nconst is = hata.workflow || {};\nconst kosum = hata.execution || {};\nconst ayrinti = kosum.error || {};\nconst satirlar = [\n  '🔴 n8n arızası',\n  `workflow: ${is.name || is.id || 'bilinmiyor'}`,\n  `calistirma: ${kosum.id || 'bilinmiyor'}`,\n  `dugum: ${ayrinti.node && ayrinti.node.name ? ayrinti.node.name : '-'}`,\n  `hata: ${ayrinti.message || 'mesaj yok'}`,\n];\nif (kosum.url) { satirlar.push(`kayit: ${kosum.url}`); }\nreturn [{ json: { message: satirlar.join('\\n') } }];"
      },
      "id": "code-message",
      "name": "Mesaj Hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        -160
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Yönetici Hedefi').item.json.admin_chat_id }}",
        "text": "={{ $('Mesaj Hazırla').item.json.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "telegram-notify",
      "name": "Telegram Bildir",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        -160
      ],
      "credentials": {
        "telegramApi": {
          "id": "VMbwUuFB8BzVhxEz",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
